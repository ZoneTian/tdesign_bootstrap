  <!-- 审核规则说明 -->
  <view class="form-reject">
    <view class="title-container">
      以下照片不能通过审核
    </view>
    <view class="reject-items">
      <view class="item">
        <image src="https://qiniustatic.womenshike.top/reject_1.jpg" mode="aspectFill" lazy-load="false" />
        <text>他人照片</text>
        <view class="error"></view>
      </view>
      <view class="item">
        <image src="https://qiniustatic.womenshike.top/reject_2.jpg" mode="aspectFill" lazy-load="false" />
        <view class="error"></view>
        <text>看不清脸</text>
      </view>
      <view class="item">
        <image src="https://qiniustatic.womenshike.top/reject_3.jpg" mode="aspectFill" lazy-load="false" />
        <view class="error"></view>
        <text>P图过度</text>
      </view>
      <view class="item">
        <image src="https://qiniustatic.womenshike.top/reject_4.jpg" mode="aspectFill" lazy-load="false" />
        <view class="error"></view>
        <text>非人物照</text>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="form-submit" bindtap="onSaveProfile">保存</view>
</view>

<date-picker
  id="birthdayPicker"
  value="{{form.birthdate}}"
  bind:confirm="onBirthdayConfirm"
  showWeek="{{false}}"
  format="YYYY-MM-DD"
/>

<region-picker
  title="选择地区"
  id="areaPicker"
  bind:hometownChange="onHometownChange"
  bind:locationChange="onLocationChange"
/>

<picker-overlay
  visible="{{picker.visible}}"
  title="{{picker.title}}"
  field-key="{{picker.field}}"
  options="{{picker.options}}"
  current-value="{{form[picker.field]}}"
  bind:confirm="onPickerConfirm"
  bind:cancel="onPickerCancel"
/>