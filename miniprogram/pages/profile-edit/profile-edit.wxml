  <!-- 个人信息部分 -->
  <view class="register-form">
    <view class="title-container">
      <view class="title-head">个人信息</view>
      <view class="title-remark">完善你的个人资料，展示更多魅力</view>
    </view>

    <!-- 昵称 -->
    <view 
      class="form-item"
      data-field="nickName"
    >
      <view class="label-group">
        <view class="label">昵称<text class="disabled"> *</text></view>
        <view wx:if="{{ !form.nickName }}" class="placeholder">请输入昵称</view>
      </view>
      <view class="label-result-input" >
        <input
          type="text"
          class="form-input"
          value="{{form.nickName}}"
          bindinput="onnickNameInput"
        />
      </view>
    </view>

    <view
      class="form-item"
      bindtap="onHandlePicker"
      data-field="gender"
      disabled
    >
      <view class="label-group">
        <text class="label">性别<text class="disabled"> *<text class="adding">无法修改</text></text></text>
        <view wx:if="{{ !form.gender }}" class="placeholder">请选择性别</view>
      </view>
      <view class="label-result">
        <input
          type="text"
          class="form-input"
          value="{{form.gender && form.gender.label}}"
          disabled
        />
      </view>
    </view>

    <view
      class="form-item"
      bindtap="showPicker"
      data-field="birthday"
      disabled
    >
      <view class="label-group">
        <text class="label">出生日期<text class="disabled"> *</text></text>
        <view wx:if="{{ !form.birthday }}" class="placeholder">请选择出生日期</view>
      </view>
      <view class="label-result">
        <input
          type="text"
          class="form-input"
          value="{{form.birthday && form.birthday.label}}"
          disabled
        />
      </view>
    </view>

    <view 
      class="form-item" 
      bindtap="onHandlePicker" 
      data-field="userHeight"
    >
      <view class="label-group">
        <text class="label">身高<text class="disabled"> *</text></text>
        <view wx:if="{{ !form.userHeight }}" class="placeholder">请选择身高</view>
      </view>
      <view class="label-result">
        <input 
          type="text" 
          class="form-input" 
          value="{{form.userHeight && form.userHeight.label}}"
          disabled
        />
      </view>
    </view>

    <view 
      class="form-item"
      data-field="userMbti"
    >
      <view class="label-group">
        <text class="label">MBTI<text class="disabled"> *</text></text>
        <view wx:if="{{ !form.userMbti }}" class="placeholder">请输入MBTI</view>
      </view>
      <view class="label-result-input">
        <input 
          type="text" 
          class="form-input" 
          value="{{form.userMbti}}"
          placeholder="请输入MBTI"
          bindinput="onMbtiInput"
        />
      </view>
    </view>

    <view 
      class="form-item" 
      bindtap="showRegionPicker"
      data-field="hometown"
    >
      <view class="label-group">
        <text class="label">家乡<text class="disabled"> *</text></text>
        <view wx:if="{{ !form.hometown }}" class="placeholder">请选择家乡</view>
      </view>
      <view class="label-result">
        <input
          type="text"
          class="form-input"
          value="{{form.hometown && form.hometown.label}}"
          disabled
        />
      </view>
    </view>

    <view 
      class="form-item" 
      bindtap="showRegionPicker"
      data-field="location"
    >
      <view class="label-group">
        <text class="label">现居地<text class="disabled"> *</text></text>
        <view wx:if="{{ !form.location }}" class="placeholder">请选择现居地</view>
      </view>
      <view class="label-result">
        <input 
          type="text" 
          class="form-input" 
          value="{{form.location && form.location.label}}"
          disabled
        />
      </view>
    </view>   
    
    <view 
      class="form-item" 
      data-field="occupation"
    >
      <view class="label-group">
        <text class="label">职业<text class="disabled"> *</text></text>
        <view wx:if="{{ !form.occupation }}" class="placeholder">请输入职业</view>
      </view>
      <view class="label-result-input">
        <input 
          type="text" 
          class="form-input" 
          value="{{form.occupation}}"
          placeholder="请输入职业"
          bindinput="onOccupationInput"
        />
      </view>
    </view>
  </view>

