{
  "name": "tdesign-bootstrap-miniprogram",
  "version": "1.0.0",
  "description": "TDesign Bootstrap 小程序项目",
  "main": "app.js",
  "scripts": {
    "test": "jest --config tests/jest.config.js",
    "test:watch": "jest --config tests/jest.config.js --watch",
    "test:coverage": "jest --config tests/jest.config.js --coverage",
    "test:ci": "jest --config tests/jest.config.js --ci --coverage --watchAll=false",
    "test:debug": "jest --config tests/jest.config.js --verbose",
    "test:debounce": "jest --config tests/jest.config.js tests/utils/debounce.test.ts",
    "test:config": "jest --config tests/jest.config.js tests/utils/debounce-config.test.ts"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node"
  },
  "keywords": [
    "miniprogram",
    "tdesign",
    "typescript",
    "debounce",
    "test"
  ],
  "author": "TDesign Team",
  "license": "MIT"
}
