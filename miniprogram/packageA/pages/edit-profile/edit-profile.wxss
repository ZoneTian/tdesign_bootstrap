/* 引入全局样式 */
@import "../../../styles/_variables.wxss";
@import "../../../styles/_mixins.wxss";

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background-image: url('https://qiniustatic.womenshike.top/background_top.png');
  background-repeat: no-repeat;
  background-position: top center;
  background-size: 100% auto;
  background-color: #fff;
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
}



/* 以下是原有样式 */
.picture-page {
  padding: 0 32rpx;
  /* 头部容器样式 */

}

.picture-wall {
  display: flex;
  flex-direction: row;
  gap: 10rpx;
  margin-top: 20rpx;
}

.picture-left {
  flex: 2;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.picture-bottom {
  flex: 1;
  display: flex;
  flex-direction: row;
  gap: 10rpx;
}

.picture-main {
  width: 226rpx;
  height: 226rpx;
  border: 2rpx solid #ccccd4;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 10rpx;
  position: relative;
}

.placeholder-pic {
  width: 32.4rpx;
  height: 30rpx;
}

.picture-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.picture-public {
  width: 106rpx;
  height: 106rpx;
  border-radius: 12rpx;
  border: 2rpx solid #ccccd4;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 10rpx;
  position: relative;
  overflow: hidden;
}

.picture-public image {
  width: 32.4rpx;
  height: 30rpx;
}

.picture-public text {
  color: #a7a7a7;
  font-size: 13rpx;
  font-weight: 400;
}

.uploaded-image-wrapper {
  width: 100%;
  height: 100%;
}

.close-icon {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 40rpx;
  height: 40rpx;
  background-color: rgba(128, 128, 128, 0.7);
  color: #fff;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  line-height: 28rpx;
  padding-bottom: 2rpx;
  z-index: 10;
}

.uploaded-image {
  width: calc(100% - 2px);
  height: calc(100% - 2px);
  border-radius: 12rpx;
}

.placeholder-main text {
  color: #a7a7a7;
  font-size: 14rpx;
  font-weight: 400;
}

.personal-info {
  padding-bottom: 93rpx;
}

.register-form {
  padding: 0 32rpx;
}

.form-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 85rpx;
  border-bottom: 1rpx solid #EEE;
}

.label-group {
  display: flex;
  flex-direction: column;
  padding-top: 8rpx;
  padding-bottom: 8rpx;
}

.label {
  font-size: 16rpx;
  font-weight: 600;
  color: #212121;
  height: 34rpx;
  line-height: 34rpx;
}

.placeholder {
  height: 34rpx;
  line-height: 34rpx;
  color: #9196a3;
  font-size: 18rpx;
  font-weight: 400;
}

.label-result-input, .label-result {
  display: flex;
  margin-left: auto;
  height: 34rpx;
  background-image: url('https://qiniustatic.womenshike.top/icon_arrow_r_personal_info.png');
  background-repeat: no-repeat;
  background-position-x: right;
  background-position-y: center;
  background-size: 15.3648rpx 26.9231rpx;
}

.form-input {
  padding: 6rpx 18rpx 6rpx 0;
  text-align: right;
  color: #9196a3;
}

.disabled {
  color: #9196a3;
  font-size: 16rpx;
  font-weight: 400;
}

.adding {
  font-size: 14rpx;
  font-weight: 400;
}

.form-submit {
  margin-top: 30px;
  background: linear-gradient(90deg, #6c7bfa 0%, #8c96ff 100%);
  border-radius: 12rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: #fff;
  margin-left: 32rpx;
  margin-right: 32rpx;
  text-align: center;
  height: 58rpx;
  line-height: 58rpx;
}