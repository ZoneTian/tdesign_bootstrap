page {
  background: linear-gradient(135deg, #F5F9FF 0%, #FFF6F9 100%);
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  padding-bottom: 40rpx;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 32rpx;
  height: 88rpx;
  position: relative;
}

.back-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-icon image {
  width: 32rpx;
  height: 32rpx;
}

.more-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.more-icon image {
  width: 32rpx;
  height: 32rpx;
}

.title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
}

.content {
  flex: 1;
  padding: 20rpx 32rpx;
  display: flex;
  flex-direction: column;
}

.tips {
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
}

.tips text {
  font-size: 26rpx;
  line-height: 40rpx;
  color: #666;
}

.input-container {
  flex: 1;
  position: relative;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  display: flex;
  flex-direction: column;
}

.textarea-wrapper {
  flex: 1;
  width: 100%;
  margin-bottom: 40rpx; /* 为字数统计留出空间 */
}

.input-area {
  width: 100%;
  min-height: 300rpx;
  font-size: 30rpx;
  line-height: 48rpx;
  color: #333;
  padding: 0;
  border: none;
}

.word-count {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  font-size: 24rpx;
  color: #999;
  background-color: transparent;
  z-index: 10;
}

.bottom-btn {
  padding: 0 32rpx;
  margin-top: auto;
}

.save-btn {
  background: linear-gradient(90deg, #A6C3FF 0%, #FFAAC6 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 12rpx;
}
